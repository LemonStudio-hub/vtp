# VTP Node Environment Variables

# Application
NODE_ENV=development
PORT=5173

# VDF Configuration
VDF_DEFAULT_TOTAL=1000000
VDF_CHECKPOINT_INTERVAL=100000

# VRF Configuration
VRF_KEYPAIR_SIZE=32

# Performance
WORKER_BATCH_SIZE=1000
WORKER_TIME_SLICE_MS=50

# Logging
LOG_LEVEL=debug
ENABLE_PERFORMANCE_MONITORING=true

# PWA
ENABLE_PWA=true
SERVICE_WORKER_PATH=/sw.js

# Networking (P2P Signaling)
# WebSocket URL of the Cloudflare Durable Object signaling server
VITE_SIGNALING_URL=ws://localhost:8787
# Room ID for peer discovery (typically the VDF challenge ID)
VITE_ROOM_ID=vtp-default
# IPv6 preference (true/false)
VITE_PREFER_IPV6=true
